{
  "name": "ucl-language",
  "displayName": "UCL \u2014 Universal Coding Language",
  "description": "UCL highlighting, context-aware completions, hover reference, save diagnostics, snippets and Run/Check commands",
  "version": "0.4.0",
  "publisher": "ucl-language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arvex-GH/universal-coding"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ucl",
        "aliases": [
          "UCL",
          "ucl"
        ],
        "extensions": [
          ".ucl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ucl",
        "scopeName": "source.ucl",
        "path": "./syntaxes/ucl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ucl.runFile",
        "title": "UCL: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "ucl.checkFile",
        "title": "UCL: Check Current File"
      },
      {
        "command": "ucl.traceFile",
        "title": "UCL: Run Current File with Trace"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ucl.runFile",
          "when": "editorLangId == ucl && isWorkspaceTrusted",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "UCL",
      "properties": {
        "ucl.executable": {
          "type": "string",
          "default": "ucl",
          "scope": "machine-overridable",
          "description": "Path to the UCL executable used for syntax/capability checking on save."
        },
        "ucl.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run ucl check on saved UCL files in trusted workspaces (no program execution)."
        }
      }
    }
  },
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting, completions and hover work without trust; execution and save diagnostics require trust."
    }
  }
}
