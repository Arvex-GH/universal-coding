{
  "name": "ucl-language",
  "displayName": "UCL — Universal Coding Language",
  "description": "UCL syntax highlighting, snippets, and file recognition",
  "version": "0.2.0",
  "publisher": "ucl-language",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/Arvex-GH/universal-coding"},
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Programming Languages", "Snippets"],
  "contributes": {
    "languages": [{"id": "ucl", "aliases": ["UCL", "ucl"], "extensions": [".ucl"], "configuration": "./language-configuration.json"}],
    "grammars": [{"language": "ucl", "scopeName": "source.ucl", "path": "./syntaxes/ucl.tmLanguage.json"}],
    "snippets": [{"language": "ucl", "path": "./snippets/ucl.json"}]
  }
}
